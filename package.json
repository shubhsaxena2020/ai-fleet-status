{
  "name": "ai-fleet-status",
  "displayName": "AI Fleet Status",
  "description": "Status bar monitor for background AI CLI agent processes (Codex, Claude Code, Gemini CLI, and more) — user-configurable, cross-platform, zero dependencies.",
  "version": "0.3.0",
  "publisher": "local",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/shubhsaxena2020/ai-fleet-status.git"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "extensionKind": ["ui", "workspace"],
  "categories": [
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "cli",
    "process-monitor",
    "status-bar",
    "codex",
    "claude",
    "gemini",
    "hermes"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aiFleetStatus.showDetails",
        "title": "AI Fleet Status: Show Details"
      },
      {
        "command": "aiFleetStatus.refresh",
        "title": "AI Fleet Status: Refresh Now"
      },
      {
        "command": "aiFleetStatus.openFleetExplorer",
        "title": "AI Fleet Status: Open Fleet Explorer"
      },
      {
        "command": "aiFleetStatus.copyDiagnostics",
        "title": "AI Fleet Status: Copy Sanitized Diagnostics"
      },
      {
        "command": "aiFleetStatus.openSession",
        "title": "AI Fleet Status: Open Session"
      },
      {
        "command": "aiFleetStatus.copyRootPid",
        "title": "AI Fleet Status: Copy Root PID"
      },
      {
        "command": "aiFleetStatus.revealTerminal",
        "title": "AI Fleet Status: Reveal Terminal"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiFleetStatus",
          "title": "AI Fleet",
          "icon": "$(rocket)"
        }
      ]
    },
    "views": {
      "aiFleetStatus": [
        {
          "id": "aiFleetStatus.fleetExplorer",
          "name": "Fleet Explorer"
        }
      ]
    },
    "configuration": {
      "title": "AI Fleet Status",
      "properties": {
        "aiFleetStatus.tools": {
          "type": "array",
          "scope": "machine",
          "markdownDescription": "AI CLI tools to detect. Each entry matches either a direct process name (native binary) or a `node`/`node.exe` process whose command line contains one of `nodeIdentityFragments` (npm-shim installs). Replaces the built-in default list entirely when set — copy the defaults from the README if you just want to add one tool.",
          "default": [
            {
              "name": "Codex",
              "processNames": ["codex.exe", "codex"],
              "nodeIdentityFragments": ["codex", "codex.cmd", "codex.exe", "codex.js"],
              "serviceSubcommands": ["mcp-server", "app-server", "remote-control", "exec-server", "app"],
              "delegatedFlags": ["exec", "review", "apply", "-e"],
              "resumeSubcommands": ["--resume", "--last"]
            },
            {
              "name": "OpenCode",
              "processNames": ["opencode.exe", "opencode"],
              "nodeIdentityFragments": ["opencode", "opencode.cmd", "opencode.exe", "opencode.js", "opencode.mjs", "opencode-ai"],
              "serviceSubcommands": ["serve", "web", "acp", "attach"],
              "delegatedFlags": ["run"],
              "resumeSubcommands": ["--resume", "--continue", "--fork"]
            },
            {
              "name": "OpenCode 2",
              "processNames": ["opencode2.exe", "opencode2"],
              "nodeIdentityFragments": ["opencode2", "opencode2.cmd", "opencode2.exe", "opencode2.js", "opencode2.mjs", "@opencode-ai/cli"],
              "serviceSubcommands": ["serve", "web", "acp", "attach"],
              "delegatedFlags": ["run", "mini"],
              "resumeSubcommands": ["--resume", "--continue", "--fork"]
            },
            {
              "name": "Hermes",
              "processNames": ["hermes.exe", "hermes"],
              "nodeIdentityFragments": ["hermes", "hermes.cmd", "hermes.exe", "hermes.js", "hermes-agent"],
              "serviceSubcommands": ["serve", "dashboard", "gui", "desktop", "acp", "gateway", "proxy", "mcp", "webhook", "monitoring", "portal", "profile"],
              "delegatedFlags": ["-z"],
              "resumeSubcommands": ["--resume", "--continue"]
            },
            {
              "name": "Antigravity",
              "processNames": ["agy.exe", "agy"],
              "nodeIdentityFragments": ["agy", "agy.cmd", "agy.exe", "agy.js"],
              "serviceSubcommands": ["mcp", "mic-serve"],
              "delegatedFlags": ["-p", "--print", "--prompt"],
              "resumeSubcommands": ["-c", "--continue", "--conversation"]
            },
            {
              "name": "Claude Code",
              "processNames": ["claude.exe", "claude"],
              "nodeIdentityFragments": ["claude", "claude.cmd", "claude.exe", "@anthropic-ai/claude-code"],
              "delegatedFlags": ["-p", "--print", "--prompt"],
              "resumeSubcommands": ["--resume", "--continue", "-c", "-r"]
            },
            {
              "name": "Gemini CLI",
              "processNames": ["gemini.exe", "gemini"],
              "nodeIdentityFragments": ["gemini", "gemini.cmd", "@google/gemini-cli", "bundle/gemini.js"],
              "delegatedFlags": ["-p", "--prompt"],
              "resumeSubcommands": ["--resume", "--continue", "-c", "-r"]
            },
            {
              "name": "Qwen Code",
              "processNames": ["qwen.exe", "qwen"],
              "nodeIdentityFragments": ["qwen", "qwen.cmd", "@qwen-code/qwen-code", "cli-entry.js"],
              "delegatedFlags": ["-p", "-i"],
              "resumeSubcommands": ["--resume", "--continue", "-c", "-r"]
            },
            {
              "name": "Goose",
              "processNames": ["goose.exe", "goose"],
              "nodeIdentityFragments": ["goose"],
              "serviceSubcommands": ["serve"],
              "delegatedFlags": ["run"],
              "resumeSubcommands": ["--resume", "--session-id"]
            },
            {
              "name": "Kiro CLI",
              "processNames": ["kiro-cli.exe", "kiro-cli"],
              "nodeIdentityFragments": ["kiro-cli"],
              "delegatedFlags": ["chat"]
            }
          ],
          "items": {
            "type": "object",
            "required": ["name", "processNames"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Display name shown in the status bar and tooltip."
              },
              "processNames": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 },
                "description": "OS-reported process names that identify this tool's native binary, e.g. [\"claude.exe\", \"claude\"]."
              },
              "actionKeywords": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 },
                "description": "OPTIONAL. Flags/subcommands that, when present, help classify the invocation mode (e.g. -p => delegated). This is now a HINT only — a matching process name already implies a session. Values are treated as literal tokens, not regular expressions."
              },
              "serviceSubcommands": {
                "type": "array",
                "default": [],
                "items": { "type": "string", "minLength": 1 },
                "description": "Subcommands (e.g. [\"serve\", \"acp\", \"mcp-server\", \"dashboard\", \"web\"]) that indicate a daemon/server mode. Processes in this mode are reported as SERVICES, not as user sessions."
              },
              "delegatedFlags": {
                "type": "array",
                "default": [],
                "items": { "type": "string", "minLength": 1 },
                "description": "Flags (e.g. [\"-p\", \"--print\", \"-z\", \"--prompt\"]) that mark a non-interactive / delegated one-shot invocation."
              },
              "resumeSubcommands": {
                "type": "array",
                "default": [],
                "items": { "type": "string", "minLength": 1 },
                "description": "Subcommands/flags (e.g. [\"--resume\", \"--continue\", \"-c\", \"-r\"]) that mark a resumed/continued session."
              },
              "nodeIdentityFragments": {
                "type": "array",
                "default": [],
                "items": { "type": "string", "minLength": 1 },
                "description": "Path fragments identifying this tool when it runs via a node/node.exe npm shim instead of its own native binary."
              }
            }
          }
        },
        "aiFleetStatus.pollInterval": {
          "type": "integer",
          "default": 5000,
          "minimum": 1000,
          "description": "How often to poll for running processes, in milliseconds, while the window is focused. Unfocused windows poll 3x less often."
        },
        "aiFleetStatus.hideWhenIdle": {
          "type": "boolean",
          "default": false,
          "description": "Hide the status bar item entirely when no configured tool is currently running."
        },
        "aiFleetStatus.enableTerminalCorrelation": {
          "type": "boolean",
          "default": true,
          "description": "Map AI sessions to the integrated VS Code terminal whose shell spawned them (when shell integration is available). External sessions are still shown as OS processes."
        },
        "aiFleetStatus.enableSessionNotifications": {
          "type": "boolean",
          "default": false,
          "description": "OPT-IN. Show a non-spammy notification when the fleet gains or loses its first/last session. Off by default to avoid notification noise."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test"
  }
}
